<Window x:Class="Trankilandia.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Trankilandia"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Button Content="Button" HorizontalAlignment="Center" Margin="0,301,0,0" VerticalAlignment="Top" Click="Button_OpenArchive"/>
        <Image HorizontalAlignment="Left" Height="238" Margin="400,53,0,0" VerticalAlignment="Top" Width="187" RenderTransformOrigin="0.5,0.5" Name="ComicImage" Stretch="Uniform">
            <Image.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform AngleX="0"/>
                    <RotateTransform/>
                    <TranslateTransform X="0"/>
                </TransformGroup>
            </Image.RenderTransform>
        </Image>
        <Button Content="Button" Click="Button_BackPage" Margin="0,106,704,62"/>
        <Button Content="Button" Margin="672,106,0,62" Name="Next" Click="Button_NextPage"/>

    </Grid>
</Window>
